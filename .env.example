# 本地运行默认不鉴权；公网部署请设置自己的密钥。
MEMORY_API_KEY=

# hash 可离线运行；dashscope 需要配置自己的密钥。
EMBEDDER=hash
DASHSCOPE_API_KEY=
EMBEDDING_MODEL=text-embedding-v4

# 规则抽取默认不调用外部模型。
LLM_EXTRACT=0
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# 开启前按 README 下载模型到本地。
RERANKER=0
RERANKER_MODEL=models/bge-reranker-base
RERANKER_TOP_N=20
RERANKER_BLEND=0.45
MAX_INFLIGHT=8
HOST=0.0.0.0
PORT=8080
