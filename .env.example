# 留空则不鉴权，便于本地契约测试。报名时填一个评测专用密钥。
MEMORY_API_KEY=

# auto: 有 DASHSCOPE_API_KEY 就用 text-embedding-v4，否则用本地哈希向量
# 学术榜请设 EMBEDDER=dashscope
EMBEDDER=auto
DASHSCOPE_API_KEY=
EMBEDDING_MODEL=text-embedding-v4

# 开源方法榜 Add 阶段预期使用 gpt-4o-mini。0 表示只用规则抽取，服务仍可运行。
LLM_EXTRACT=0
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

HOST=0.0.0.0
PORT=8080
